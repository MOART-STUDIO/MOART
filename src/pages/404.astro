---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths.js";
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o se ha movido. Vuelve al catálogo de esculturas de MOART." noindex={true} includeHeader={false} includeFooter={false}>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-base px-4">
    <div class="max-w-md text-center">
      <h1 class="font-serif text-7xl">404</h1>
      <h2 class="mt-4 font-serif text-2xl">Página no encontrada</h2>
      <p class="mt-2 text-sm text-faded">La página que buscas no existe o se ha movido.</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={withBase("/catalog")}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-5 py-3 text-xs uppercase tracking-widest text-[var(--color-base)] transition-colors hover:bg-accent"
        >
          Volver al catálogo
        </a>
        <a
          href={withBase("/")}
          class="inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-xs uppercase tracking-widest text-ink ring-1 ring-line transition-colors hover:bg-paper"
        >
          Ir al inicio
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
