---
import { Image } from "astro:assets";
import { formatPrice } from "@/data/products.js";
import { withBase } from "@/utils/paths.js";

const {
  product,
  eager = false,
  nameOverride = product.name,
  shortOverride = product.shortDescription,
} = Astro.props;
---

<a href={withBase(`/products/${product.slug}`)} class="group block space-y-4" data-product-card>
  <div class="aspect-[4/5] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
    <Image
      src={product.images[0]}
      alt={`${nameOverride} — ${shortOverride}`}
      width={1024}
      height={1280}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      format="webp"
      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-sm font-medium">{nameOverride}</h2>
      <p class="text-xs text-faded">{shortOverride}</p>
    </div>
    <span class="text-sm tabular-nums">{formatPrice(product.price)}</span>
  </div>
</a>
