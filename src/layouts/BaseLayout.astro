---
import "../styles.css";
import Seo from "@/components/Seo.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import type { ImageMetadata } from "astro";

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: "website" | "article" | "product" | "profile";
  schema?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  includeHeader?: boolean;
  includeFooter?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  ogType = "website",
  schema,
  publishedTime,
  modifiedTime,
  includeHeader = true,
  includeFooter = true,
  bodyClass = "bg-base text-ink",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      nofollow={nofollow}
      ogType={ogType}
      schema={schema}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <script is:inline>
      (() => {
        const storageKey = "moart-cart";

        function readCart() {
          try {
            return JSON.parse(window.localStorage.getItem(storageKey) || "[]");
          } catch {
            return [];
          }
        }

        function writeCart(items) {
          window.localStorage.setItem(storageKey, JSON.stringify(items));
          document.dispatchEvent(new CustomEvent("moart-cart-change", { detail: items }));
        }

        function count(items = readCart()) {
          return items.reduce((total, item) => total + Number(item.quantity || 0), 0);
        }

        function updateBadges() {
          const total = count();
          document.querySelectorAll("[data-cart-count]").forEach((node) => {
            node.textContent = `(${total})`;
          });
          document.querySelectorAll("[data-cart-label]").forEach((node) => {
            node.setAttribute("aria-label", `Colección, ${total} ${total === 1 ? "pieza" : "piezas"}`);
          });
        }

        window.MoartCart = {
          read: readCart,
          write: writeCart,
          count,
          add(slug, quantity = 1) {
            const items = readCart();
            const existing = items.find((item) => item.slug === slug);
            if (existing) {
              existing.quantity += quantity;
              writeCart(items);
              return;
            }
            writeCart([...items, { slug, quantity, packaging: false }]);
          },
          remove(slug) {
            writeCart(readCart().filter((item) => item.slug !== slug));
          },
          setQuantity(slug, quantity) {
            if (quantity <= 0) {
              this.remove(slug);
              return;
            }
            writeCart(readCart().map((item) => (item.slug === slug ? { ...item, quantity } : item)));
          },
          setPackaging(slug, enabled) {
            writeCart(readCart().map((item) => (item.slug === slug ? { ...item, packaging: enabled } : item)));
          },
          updateBadges,
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", updateBadges);
        } else {
          updateBadges();
        }
        window.addEventListener("storage", updateBadges);
        document.addEventListener("moart-cart-change", updateBadges);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-base)]"
    >
      Saltar al contenido
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <slot />
    {includeFooter && <SiteFooter />}
  </body>
</html>
